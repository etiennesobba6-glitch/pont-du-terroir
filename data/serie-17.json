  "moundang": "We kee fan ne kyaŋ ge səŋ."
 },
 {
  "id": "s17-11",
  "fr": "Répétez après moi.",
  "en": "Repeat after me.",
  "moundang": "We faa fahfal ɓe."
 },
 {
  "id": "s17-12",
  "fr": "Qui connaît la réponse ?",
  "en": "Who knows the answer?",
  "moundang": "Azu tə zyii ah ɓe ne?"
 },
 {
  "id": "s17-13",
  "fr": "Levez la main avant de parler.",
  "en": "Raise your hand before speaking.",
