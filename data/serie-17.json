  "moundang": "We ne fii no ne?"
 },
 {
  "id": "s17-19",
  "fr": "Merci pour votre attention.",
  "en": "Thank you for your attention.",
  "moundang": "Soko mor we syii sok pəsãhe"
 },
 {
  "id": "s17-20",
  "fr": "À demain, les enfants !",
  "en": "See you tomorrow, children!",
  "moundang": "Sai tə'nan o weere"
 }
