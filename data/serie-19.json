[
 {
  "id": "s19-01",
  "fr": "Quel est ton métier ?",
  "en": "What is your job?",
  "moundang": "Amo joŋ yeɓ fẽene?"
 },
 {
  "id": "s19-02",
  "fr": "Je suis enseignant.",
  "en": "I am a teacher.",
  "moundang": "Me cuu fanne."
 },
 {
  "id": "s19-03",
  "fr": "Il est agriculteur.",
  "en": "He is a farmer.",
  "moundang": "Ako ye dəɓ pəpəə."
 },
 {
  "id": "s19-04",
  "fr": "Elle est infirmière.",
  "en": "She is a nurse.",
  "moundang": "Ako ye dəɓtər ma lanni"
 },
 {
  "id": "s19-05",
  "fr": "Mon frère est mécanicien.",
  "en": "My brother is a mechanic.",
  "moundang": "Na maɓe ma wor makanisyãh yo."
 },
 {
  "id": "s19-06",
  "fr": "Ma sœur est couturière.",
  "en": "My sister is a tailor.",
  "moundang": "Na maɓe ma win ma sãa fan o."
 },
 {
  "id": "s19-07",
  "fr": "Je vais au travail.",
  "en": "I am going to work.",
  "moundang": "Me tə ga yeɓɓe."
 },
 {
  "id": "s19-08",
  "fr": "Le travail commence à huit heures.",
  "en": "Work starts at eight o'clock.",
  "moundang": "Yeɓ a təŋ ne vãm nama."
 },
 {
  "id": "s19-09",
  "fr": "J'aime mon travail.",
  "en": "I like my job.",
  "moundang": "Me 'yah yeɓ ɓe no."
 },
 {
  "id": "s19-10",
  "fr": "Aujourd'hui, je travaille beaucoup.",
  "en": "Today I am working hard.",
  "moundang": "Tə'naãh me tə joŋ yeɓ pəli."
 },
 {
  "id": "s19-11",
  "fr": "Nous travaillons en équipe.",
  "en": "We work as a team.",
  "moundang": "Ru joŋ yeɓ nə kwəlii."
 },
 {
  "id": "s19-12",
  "fr": "Le travail est terminé.",
  "en": "The work is finished.",
  "moundang": "Yeɓ vər ɓe."
 },
 {
  "id": "s19-13",
  "fr": "Bon travail !",
  "en": "Good job!",
  "moundang": "Mo joŋ yeɓ ne jam!"
 },
 {
  "id": "s19-14",
  "fr": "Cherche du travail.",
  "en": "Look for a job.",
  "moundang": "Mo kyeɓ yeɓɓe."
 },
 {
  "id": "s19-15",
  "fr": "Il aime aider les autres.",
  "en": "He likes helping others.",
  "moundang": "A 'yah ko gbahjol za ki."
 },
 {
  "id": "s19-16",
  "fr": "Chaque métier est important.",
  "en": "Every job is important.",
  "moundang": "Yeɓ daŋ nə yəkki."
 },
 {
  "id": "s19-17",
  "fr": "Sois honnête dans ton travail.",
  "en": "Be honest in your work.",
  "moundang": "Mo joŋ yeɓ ɓo ne goŋga."
 },
 {
  "id": "s19-18",
  "fr": "Le travail demande de la patience.",
  "en": "Work requires patience.",
  "moundang": "Yeɓ ka fii mo yea ne tə'yak həə yaa."
 },
 {
  "id": "s19-19",
  "fr": "Repose-toi après le travail.",
  "en": "Rest after work.",
  "moundang": "Mo ur yeɓ ɓe mo 'yak suu."
 },
 {
  "id": "s19-20",
  "fr": "Le travail bien fait apporte de la joie.",
  "en": "Well-done work brings joy.",
  "moundang": "Yeɓ sãh a ge ne laa pə'yãhre."
 }
]