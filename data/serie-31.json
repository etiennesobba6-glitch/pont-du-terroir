[
 {
  "id": "s31-01",
  "fr": "Je vais au champ.",
  "en": "I am going to the farm.",
  "moundang": "Me ga 'wahe"
 },
 {
  "id": "s31-02",
  "fr": "Nous cultivons le maïs.",
  "en": "We grow maize.",
  "moundang": "Aru pəə sor zuhuŋni."
 },
 {
  "id": "s31-03",
  "fr": "Nous cultivons le mil.",
  "en": "We grow millet.",
  "moundang": "Ru pəə sorre."
 },
 {
  "id": "s31-04",
  "fr": "Nous cultivons le sorgho.",
  "en": "We grow sorghum.",
  "moundang": "Ru pəə sor kalle."
 },
 {
  "id": "s31-05",
  "fr": "Il faut préparer le champ.",
  "en": "We must prepare the field.",
  "moundang": "A fii ka zyeɓ 'wahe."
 },
 {
  "id": "s31-06",
  "fr": "La terre est fertile.",
  "en": "The soil is fertile.",
  "moundang": "Sər ah pə swahe."
 },
 {
  "id": "s31-07",
  "fr": "Il commence à pleuvoir.",
  "en": "It is starting to rain.",
  "moundang": "Bam təŋ tan ɓe."
 },
 {
  "id": "s31-08",
  "fr": "Nous semons aujourd'hui.",
  "en": "We are sowing today.",
  "moundang": "Ru tə ruu fan tə'nah ko."
 },
 {
  "id": "s31-09",
  "fr": "Les plantes poussent bien.",
  "en": "The plants are growing well.",
  "moundang": "Fan ruu tə ciŋ pəsãh no."
 },
 {
  "id": "s31-10",
  "fr": "Il faut enlever les mauvaises herbes.",
  "en": "We must remove the weeds.",
  "moundang": "A fii ka lwəə fãa ga lalle."
 },
 {
  "id": "s31-11",
  "fr": "La récolte sera bonne.",
  "en": "The harvest will be good.",
  "moundang": "Fan gwahl ga yea pəsãhe."
 },
 {
  "id": "s31-12",
  "fr": "Nous récoltons le maïs.",
  "en": "We are harvesting maize.",
  "moundang": "Ru tə hah sor zuhuŋni."
 },
 {
  "id": "s31-13",
  "fr": "Les sacs sont pleins.",
  "en": "The sacks are full.",
  "moundang": "Dahra baa ɓe."
 },
 {
  "id": "s31-14",
  "fr": "Transportons la récolte.",
  "en": "Let's transport the harvest.",
  "moundang": "Na woo fan kpãhpəə ga yaŋ."
 },
 {
  "id": "s31-15",
  "fr": "Le travail est terminé.",
  "en": "The work is finished.",
  "moundang": "Yeɓ vərɓe."
 },
 {
  "id": "s31-16",
  "fr": "Merci pour votre aide.",
  "en": "Thank you for your help.",
  "moundang": "Soko mor gbahjol ɓiiri."
 },
 {
  "id": "s31-17",
  "fr": "L'agriculture nourrit la famille.",
  "en": "Farming feeds the family.",
  "moundang": "Fankpahəə a wol piicelle."
 },
 {
  "id": "s31-18",
  "fr": "Il faut protéger les cultures.",
  "en": "We must protect the crops.",
  "moundang": "A fii ka byak fan kpahpəə."
 },
 {
  "id": "s31-19",
  "fr": "Un bon agriculteur est patient.",
  "en": "A good farmer is patient.",
  "moundang": "Dəɓ pəpəə ma nə tətəl a yea pə moyen."
 },
 {
  "id": "s31-20",
  "fr": "Que Dieu bénisse nos récoltes.",
  "en": "May God bless our harvests.",
  "moundang": "Masəŋ mo kãn ko ẽe ah tə fan gwahl mana."
 }
]