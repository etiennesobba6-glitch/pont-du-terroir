[
 {
  "id": "s13-01",
  "fr": "Quelle heure est-il ?",
  "en": "What time is it?",
  "moundang": "Cok com kəɗəne?"
 },
 {
  "id": "s13-02",
  "fr": "Il est une heure.",
  "en": "It is one o'clock.",
  "moundang": "Cok com vaŋno yo."
 },
 {
  "id": "s13-03",
  "fr": "Il est deux heures.",
  "en": "It is two o'clock.",
  "moundang": "Cok com gwaa yo."
 },
 {
  "id": "s13-04",
  "fr": "Il est midi.",
  "en": "It is noon.",
  "moundang": "Cok com kəsyiitətəl joŋ ɓe."
 },
 {
  "id": "s13-05",
  "fr": "Il est minuit.",
  "en": "It is midnight.",
  "moundang": "Kəsyiisuŋ joŋ ɓe."
 },
 {
  "id": "s13-06",
  "fr": "Il est six heures et demie.",
  "en": "It is half past six.",
  "moundang": "Vãm yea ne reeta yo."
 },
 {
  "id": "s13-07",
  "fr": "Il est huit heures moins le quart.",
  "en": "It is a quarter to eight.",
  "moundang": "Coŋ ɓo minutə jamma təl dappe ka ka vãm nama mo joŋ."
 },
 {
  "id": "s13-08",
  "fr": "Il est neuf heures et quart.",
  "en": "It is a quarter past nine.",
  "moundang": "Vãm doraŋ ne minutə jamma təl dappe yo."
 },
 {
  "id": "s13-09",
  "fr": "Je suis en avance.",
  "en": "I am early.",
  "moundang": "Me kal ɓo ge pelle."
 },
 {
  "id": "s13-10",
  "fr": "Je suis en retard.",
  "en": "I am late.",
  "moundang": "Me zah falle."
 },
 {
  "id": "s13-11",
  "fr": "Dépêche-toi !",
  "en": "Hurry up!",
  "moundang": "Mo həəre!"
 },
 {
  "id": "s13-12",
  "fr": "Attends un instant.",
  "en": "Wait a moment.",
  "moundang": "Mo byak njee ɗao."
 },
 {
  "id": "s13-13",
  "fr": "Prends ton temps.",
  "en": "Take your time.",
  "moundang": "Mo ge suu sak."
 },
 {
  "id": "s13-14",
  "fr": "Nous partirons dans une heure.",
  "en": "We will leave in one hour.",
  "moundang": "Coŋ ɓo vãm vaŋno ka na kalle."
 },
 {
  "id": "s13-15",
  "fr": "Le cours commence à huit heures.",
  "en": "The class starts at eight o'clock.",
  "moundang": "Fan fee a təŋ ne vãm nama."
 },
 {
  "id": "s13-16",
  "fr": "Le travail est terminé.",
  "en": "The work is finished.",
  "moundang": "Yeɓ vər ɓe."
 },
 {
  "id": "s13-17",
  "fr": "C'est le bon moment.",
  "en": "It is the right time.",
  "moundang": "Cok ah ma sãh joŋ ɓe."
 },
 {
  "id": "s13-18",
  "fr": "Il est déjà tard.",
  "en": "It is already late.",
  "moundang": "Cok pəə̃ ɓe."
 },
 {
  "id": "s13-19",
  "fr": "À quelle heure viendras-tu ?",
  "en": "What time will you come?",
  "moundang": "Mo ga ge ne vãm kəɗəne?"
 },
 {
  "id": "s13-20",
  "fr": "Je viendrai à dix heures.",
  "en": "I will come at ten o'clock.",
  "moundang": "Me ga ge ne vãm jamma."
 }
]