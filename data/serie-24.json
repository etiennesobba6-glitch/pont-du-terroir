  "moundang": "Mo ge jaŋjaŋ"
 },
 {
  "id": "s24-18",
  "fr": "Nous sommes presque arrivés.",
  "en": "We are almost there.",
  "moundang": "Ru tə dai cok o."
 },
 {
  "id": "s24-19",
  "fr": "Le voyage s'est bien passé.",
  "en": "The journey went well.",
  "moundang": "Fahlii gwəə syee pəsãh ɓe."
 },
 {
  "id": "s24-20",
