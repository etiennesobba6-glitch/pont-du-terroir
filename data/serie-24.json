  "moundang": "Me ga yaŋ o."
 },
 {
  "id": "s24-03",
  "fr": "Viens avec moi.",
  "en": "Come with me.",
  "moundang": "Mo ge nə me."
 },
 {
  "id": "s24-04",
  "fr": "Allons ensemble.",
  "en": "Let's go together.",
  "moundang": "Na ge mor ki."
 },
 {
  "id": "s24-05",
  "fr": "Marche doucement.",
  "en": "Walk slowly.",
  "moundang": "Mo syee suu sak."
 },
 {
  "id": "s24-06",
  "fr": "Marche plus vite.",
