[
 {
  "id": "s27-01",
  "fr": "J'aime voyager.",
  "en": "I like traveling.",
  "moundang": "Me 'yah ɓə joŋ gwəəre."
 },
 {
  "id": "s27-02",
  "fr": "Où vas-tu ?",
  "en": "Where are you going?",
  "moundang": "Mo ga kẽne?"
 },
 {
  "id": "s27-03",
  "fr": "Je vais à Yaoundé.",
  "en": "I am going to Yaoundé.",
  "moundang": "Me ga Yaoundé."
 },
 {
  "id": "s27-04",
  "fr": "C'est mon premier voyage.",
  "en": "This is my first trip.",
  "moundang": "Fahlii gwəə ɓe ma kəpel yo."
 },
 {
  "id": "s27-05",
  "fr": "Le voyage est long.",
  "en": "The journey is long.",
  "moundang": "Fahlii gwəə ah pəwahe."
 },
 {
  "id": "s27-06",
  "fr": "Le voyage est agréable.",
  "en": "The journey is pleasant.",
  "moundang": "Fahlii gwəə ah pə'nyãhre."
 },
 {
  "id": "s27-07",
  "fr": "J'ai préparé mes bagages.",
  "en": "I have packed my luggage.",
  "moundang": "Ame dahɓ faswaa ɓe ɓe"
 },
 {
  "id": "s27-08",
  "fr": "N'oublie pas ton passeport.",
  "en": "Don't forget your passport.",
  "moundang": "Mo yaŋtəl pasəpor ɓo ka"
 },
 {
  "id": "s27-09",
  "fr": "Vérifie tes documents.",
  "en": "Check your documents.",
  "moundang": "Mo jin ẽe ɗerewol ɓo ra pəsãhe."
 },
 {
  "id": "s27-10",
  "fr": "Nous partons demain matin.",
  "en": "We are leaving tomorrow morning.",
  "moundang": "Na ga kal tə'nan nə zah'nanne."
 },
 {
  "id": "s27-11",
  "fr": "Le train est à l'heure.",
  "en": "The train is on time.",
  "moundang": "Təraiŋ ge dai nə cok ah ɓe."
 },
 {
  "id": "s27-12",
  "fr": "L'avion vient d'atterrir.",
  "en": "The plane has just landed.",
  "moundang": "Avioŋ ge dai ɓo təzəə̃ ko."
 },
 {
  "id": "s27-13",
  "fr": "Le vol est retardé.",
  "en": "The flight is delayed.",
  "moundang": "Avioŋ ka ha ur gwaari ya."
 },
 {
  "id": "s27-14",
  "fr": "Je voyage avec ma famille.",
  "en": "I am traveling with my family.",
  "moundang": "Me ga joŋ gwəə ne dəfuu piicel ɓe daŋ."
 },
 {
  "id": "s27-15",
  "fr": "Le paysage est magnifique.",
  "en": "The scenery is beautiful.",
  "moundang": "Cok ah a kwan pəsãhe."
 },
 {
  "id": "s27-16",
  "fr": "Prenons une photo.",
  "en": "Let's take a photo.",
  "moundang": "Na gbə fato."
 },
 {
  "id": "s27-17",
  "fr": "J'ai passé un bon voyage.",
  "en": "I had a good trip.",
  "moundang": "Fahlii gwəə ah syee pəsãh ɓe."
 },
 {
  "id": "s27-18",
  "fr": "Je reviendrai bientôt.",
  "en": "I will come back soon.",
  "moundang": "Ga pel njee ɓe me soo jin ge baa."
 },
 {
  "id": "s27-19",
  "fr": "Merci pour votre accueil.",
  "en": "Thank you for your welcome.",
  "moundang": "Soko mor mo nyiŋ gwəə ɓe."
 },
 {
  "id": "s27-20",
  "fr": "À bientôt !",
  "en": "See you soon!",
  "moundang": "Sai pel o."
 }
]