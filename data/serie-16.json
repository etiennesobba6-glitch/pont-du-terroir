[
 {
  "id": "s16-01",
  "fr": "Je vais à l'école.",
  "en": "I am going to school.",
  "moundang": "Me ga lekol."
 },
 {
  "id": "s16-02",
  "fr": "L'école est ouverte.",
  "en": "The school is open.",
  "moundang": "Lekol gbər ɓe."
 },
 {
  "id": "s16-03",
  "fr": "Les élèves arrivent.",
  "en": "The pupils are arriving.",
  "moundang": "Wee lekol tə daira o."
 },
 {
  "id": "s16-04",
  "fr": "Le maître est en classe.",
  "en": "The teacher is in the classroom.",
  "moundang": "Pa cuu fan a ɓər yaŋ fee fanne."
 },
 {
  "id": "s16-05",
  "fr": "La maîtresse explique la leçon.",
  "en": "The teacher is explaining the lesson.",
  "moundang": "Ma cuu fan tə gbai mor ɓə fan cuuni."
 },
 {
  "id": "s16-06",
  "fr": "J'aime apprendre.",
  "en": "I like learning.",
  "moundang": "Me 'yah fee fanne."
 },
 {
  "id": "s16-07",
  "fr": "Nous étudions aujourd'hui.",
  "en": "We are studying today.",
  "moundang": "Ru ga fee fan tə'nah ko."
 },
 {
  "id": "s16-08",
  "fr": "L'école commence à huit heures.",
  "en": "School starts at eight o'clock.",
  "moundang": "Fan fee a təŋ ne vãm nama'"
 },
 {
  "id": "s16-09",
  "fr": "La récréation est terminée.",
  "en": "Break time is over.",
  "moundang": "Cok 'yak izah ɓe."
 },
 {
  "id": "s16-10",
  "fr": "Les élèves sont attentifs.",
  "en": "The pupils are attentive.",
  "moundang": "Wee syiira sok ɓo"
 },
 {
  "id": "s16-11",
  "fr": "Fais bien tes devoirs.",
  "en": "Do your homework well.",
  "moundang": "Mo joŋ yeɓ mai pa cuu fan mo nyii ɓo nyi mo."
 },
 {
  "id": "s16-12",
  "fr": "J'ai réussi mon examen.",
  "en": "I passed my exam.",
  "moundang": "Me lwaa ekzamen ɓe."
 },
 {
  "id": "s16-13",
  "fr": "Félicitations pour ta réussite !",
  "en": "Congratulations on your success!",
  "moundang": "Me bər mo mor mo lwaa fan ɓe."
 },
 {
  "id": "s16-14",
  "fr": "Il faut étudier chaque jour.",
  "en": "You must study every day.",
  "moundang": "Mo fee fan zah'nan daŋ."
 },
 {
  "id": "s16-15",
  "fr": "L'éducation est importante.",
  "en": "Education is important.",
  "moundang": "Lai wee ɓə ah pə yəkki."
 },
 {
  "id": "s16-16",
  "fr": "Je veux devenir enseignant.",
  "en": "I want to become a teacher.",
  "moundang": "Me 'yah me cĩŋ pa cuu fanne."
 },
 {
  "id": "s16-17",
  "fr": "Mon ami est un bon élève.",
  "en": "My friend is a good student.",
  "moundang": "Paryaŋ ɓe we lekol sãh yo."
 },
 {
  "id": "s16-18",
  "fr": "Nous chantons avant le cours.",
  "en": "We sing before class.",
  "moundang": "Aru ɗəələŋ kəpel fan feere."
 },
 {
  "id": "s16-19",
  "fr": "À demain à l'école.",
  "en": "See you tomorrow at school.",
  "moundang": "Na lwaa ki tə'nan lekol baa."
 },
 {
  "id": "s16-20",
  "fr": "Bonne rentrée scolaire !",
  "en": "Happy back-to-school!",
  "moundang": "Mo təŋ lekol ne jam."
 }
]