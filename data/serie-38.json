[
 {
  "id": "s38-01",
  "fr": "J'habite dans un village.",
  "en": "I live in a village.",
  "moundang": "Me kaa ɓo yaŋ laŋni."
 },
 {
  "id": "s38-02",
  "fr": "Mon frère habite en ville.",
  "en": "My brother lives in town.",
  "moundang": "Naa maɓe ma wor kaa ɓo yaŋ lii."
 },
 {
  "id": "s38-03",
  "fr": "Le village est calme.",
  "en": "The village is peaceful.",
  "moundang": "Yaŋ laŋ a yea 'waa"
 },
 {
  "id": "s38-04",
  "fr": "La ville est très animée.",
  "en": "The town is very lively.",
  "moundang": "Yaŋ lii a yea mgbiŋmgbiŋ."
 },
 {
  "id": "s38-05",
  "fr": "Les voisins sont accueillants.",
  "en": "The neighbors are welcoming.",
  "moundang": "Za jak a nyiira gwəəre."
 },
 {
  "id": "s38-06",
  "fr": "Nous nous aidons les uns les autres.",
  "en": "We help one another.",
  "moundang": "Ru gbahjol kii.."
 },
 {
  "id": "s38-07",
  "fr": "Le marché est ouvert aujourd'hui.",
  "en": "The market is open today.",
  "moundang": "Tə'nah luma gbər ɓo."
 },
 {
  "id": "s38-08",
  "fr": "L'école est près de chez moi.",
  "en": "The school is near my home.",
  "moundang": "Lekol a kah yaŋ ɓe."
 },
 {
  "id": "s38-09",
  "fr": "Il y a un centre de santé dans le village.",
  "en": "There is a health center in the village.",
  "moundang": "Yaŋ syiŋ a no yaŋ ɓuuru."
 },
 {
  "id": "s38-10",
  "fr": "La route est en bon état.",
  "en": "The road is in good condition.",
  "moundang": "Fahlii pəsãhe."
 },
 {
  "id": "s38-11",
  "fr": "Les enfants jouent dehors.",
  "en": "The children are playing outside.",
  "moundang": "Wee tə joŋra kyẽm lalle."
 },
 {
  "id": "s38-12",
  "fr": "Nous saluons toujours nos voisins.",
  "en": "We always greet our neighbors.",
  "moundang": "Ru haozah nyii za jak ɓuu cẽecẽe."
 },
 {
  "id": "s38-13",
  "fr": "Les habitants vivent en paix.",
  "en": "The people live in peace.",
  "moundang": "Za yaŋ laŋ a haira wo ki nə jam."
 },
 {
  "id": "s38-14",
  "fr": "Chacun participe au développement de la communauté.",
  "en": "Everyone contributes to the community's development.",
  "moundang": "Za daŋ a joŋra yeɓ mor ga pel yaŋ."
 },
 {
  "id": "s38-15",
  "fr": "La ville offre de nombreuses possibilités.",
  "en": "The town offers many opportunities.",
  "moundang": "Fan ma gbahjol camcam a yea yaŋ lii."
 },
 {
  "id": "s38-16",
  "fr": "Le village conserve de belles traditions.",
  "en": "The village preserves beautiful traditions.",
  "moundang": "Zahsyĩŋra ma sãh camcam a yea yaŋ laŋni."
 },
 {
  "id": "s38-17",
  "fr": "Respectons les biens publics.",
  "en": "Let's respect public property.",
  "moundang": "Na kee fan za pãare."
 },
 {
  "id": "s38-18",
  "fr": "Vivons ensemble dans le respect.",
  "en": "Let us live together with respect.",
  "moundang": "Na hai wo ki nə kee ki."
 },
 {
  "id": "s38-19",
  "fr": "L'union fait la force.",
  "en": "Unity is strength.",
  "moundang": "Gbanzah wo ki a nyii swahe."
 },
 {
  "id": "s38-20",
  "fr": "Notre communauté est notre richesse.",
  "en": "Our community is our wealth.",
  "moundang": "Dəfuu man ye joŋ mana."
 }
]