[
 {
  "id": "s39-01",
  "fr": "Bonjour, mon ami.",
  "en": "Hello, my friend.",
  "moundang": "Me haozah mo ɓe paryaŋ ɓe."
 },
 {
  "id": "s39-02",
  "fr": "Comment va ta famille ?",
  "en": "How is your family?",
  "moundang": "Piicel ɓo ga ɗəne?"
 },
 {
  "id": "s39-03",
  "fr": "Merci de ta visite.",
  "en": "Thank you for your visit.",
  "moundang": "Soko mor mo ge ẽe me."
 },
 {
  "id": "s39-04",
  "fr": "Tu es toujours le bienvenu.",
  "en": "You are always welcome.",
  "moundang": "Me nyii mo nə laa pə'nyãh cẽecẽe."
 },
 {
  "id": "s39-05",
  "fr": "J'apprécie ton amitié.",
  "en": "I appreciate your friendship.",
  "moundang": "Me sãa mo paryaŋ ɓe."
 },
 {
  "id": "s39-06",
  "fr": "Aidons-nous les uns les autres.",
  "en": "Let us help one another.",
  "moundang": "Na gbahjol kii."
 },
 {
  "id": "s39-07",
  "fr": "Le respect est important.",
  "en": "Respect is important.",
  "moundang": "Kee suu a pə yəkki."
 },
 {
  "id": "s39-08",
  "fr": "Il faut dire la vérité.",
  "en": "We should tell the truth.",
  "moundang": "Mo faa goŋnga"
 },
 {
  "id": "s39-09",
  "fr": "Pardonne-moi, s'il te plaît.",
  "en": "Please forgive me.",
  "moundang": "Mo rõm me, me pəə so."
 },
 {
  "id": "s39-10",
  "fr": "Je te pardonne.",
  "en": "I forgive you.",
  "moundang": "Me rõm mo ɓe."
 },
 {
  "id": "s39-11",
  "fr": "Vivons en paix.",
  "en": "Let us live in peace.",
  "moundang": "Na kaa wo ki nə jam."
 },
 {
  "id": "s39-12",
  "fr": "Écoutons les autres avec attention.",
  "en": "Let us listen to others carefully.",
  "moundang": "Na syii sok ka laa ɓəfaa kii pəsãhe."
 },
 {
  "id": "s39-13",
  "fr": "Chacun mérite le respect.",
  "en": "Everyone deserves respect.",
  "moundang": "Zune daŋ 'yah za mo kee zye."
 },
 {
  "id": "s39-14",
  "fr": "Les bons voisins s'entraident.",
  "en": "Good neighbors help each other.",
  "moundang": "Za jək ma sãh ah a gbahra jol ki."
 },
 {
  "id": "s39-15",
  "fr": "Merci pour ton soutien.",
  "en": "Thank you for your support.",
  "moundang": "Soko mor gbahjol ɓo."
 },
 {
  "id": "s39-16",
  "fr": "Je suis heureux de te voir.",
  "en": "I am happy to see you.",
  "moundang": "Me laapə'nyãh nə kwan mo."
 },
 {
  "id": "s39-17",
  "fr": "À bientôt, mon ami.",
  "en": "See you soon, my friend.",
  "moundang": "Sai pel o paryaŋ ɓe."
 },
 {
  "id": "s39-18",
  "fr": "Passe le bonjour à ta famille.",
  "en": "Give my greetings to your family.",
  "moundang": "Mo haozah piicel ɓo gŋ."
 },
 {
  "id": "s39-19",
  "fr": "Prenons soin les uns des autres.",
  "en": "Let us take care of one another.",
  "moundang": "Na gbə ki pəsãh kəsyil kii."
 },
 {
  "id": "s39-20",
  "fr": "L'amitié est un trésor.",
  "en": "Friendship is a treasure.",
  "moundang": "Gban paryaŋ sye joŋ yo."
 }
]